---
import { getCategory } from '../lib/events';
import type { EventItem } from '../lib/events';
import { formatDateRange } from '../lib/dates';
import { useTranslations, localizedPath, withBase, type Lang } from '../lib/i18n';
import CategoryBadge from './CategoryBadge.astro';

interface Props {
  event: EventItem;
  lang: Lang;
}

const { event, lang } = Astro.props;
const t = useTranslations(lang);
const href = localizedPath(`/esdeveniment/${event.slug}`, lang);
const searchText = [
  event.title[lang],
  event.description[lang],
  event.location.name[lang],
]
  .join(' ')
  .normalize('NFD')
  .replace(/[̀-ͯ]/g, '')
  .toLowerCase();

// Literal classes so Tailwind's build-time scanner keeps them (see CategoryBadge.astro).
const topBorderClasses: Record<string, string> = {
  grape: 'border-t-grape',
  ochre: 'border-t-ochre',
  leaf: 'border-t-leaf',
  sky: 'border-t-sky',
  sun: 'border-t-sun',
  wine: 'border-t-wine',
  earth: 'border-t-earth',
  stone: 'border-t-stone',
};
const accentColor = getCategory(event.category)?.color ?? 'stone';
const topBorder = topBorderClasses[accentColor] ?? topBorderClasses.stone;
---

<article
  class:list={[
    'group flex flex-col overflow-hidden rounded-2xl border border-stone/15 border-t-4 bg-white shadow-sm transition-all duration-200 hover:-translate-y-1 hover:shadow-lg',
    topBorder,
  ]}
  data-event-card
  data-category={event.category}
  data-search-text={searchText}
>
  <a href={href} class="block overflow-hidden">
    {
      event.image && (
        <img
          src={withBase(event.image)}
          alt={event.imageAlt?.[lang] ?? ''}
          class="h-40 w-full object-cover transition-transform duration-300 group-hover:scale-105"
          loading="lazy"
        />
      )
    }
  </a>
  <div class="flex flex-1 flex-col gap-2 p-4">
    <div class="flex flex-wrap items-center gap-2">
      <CategoryBadge categoryId={event.category} lang={lang} />
      {event.isExample && <span class="text-xs font-semibold uppercase text-wine">{t('event.example')}</span>}
    </div>
    <h3 class="font-serif text-lg font-bold leading-snug">
      <a href={href} class="hover:text-grape">
        {event.title[lang]}
      </a>
    </h3>
    <p class="text-sm font-semibold text-stone">
      <time datetime={event.start}>{formatDateRange(event.start, event.end, lang)}</time>
    </p>
    <p class="text-sm text-stone">{event.location.name[lang]}</p>
    <p class="mt-auto pt-2 text-sm font-semibold">
      {event.price.type === 'free' ? (
        <span class="text-leaf">{t('event.free')}</span>
      ) : (
        <span class="text-ochre">
          {t('event.paid')} {event.price.amount ? `· ${event.price.amount} €` : ''}
        </span>
      )}
    </p>
  </div>
</article>
