---
import { useTranslations, localizedPath, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<footer class="border-t border-stone/15 bg-cream-dark">
  <div class="mx-auto max-w-5xl px-4 py-8 text-sm text-stone">
    <p>
      {t('footer.editData')}
      {' '}
      <strong>README.md</strong> {t('footer.editDataLink')}.
    </p>
    <p class="mt-2">{t('footer.rights')}</p>
    <p class="mt-1">
      <a href={localizedPath('/llocs', lang)} class="underline hover:text-grape">{t('nav.places')}</a>
      ·
      <a href={localizedPath('/passats', lang)} class="underline hover:text-grape">{t('nav.past')}</a>
    </p>
  </div>
</footer>
