---
import { getUpcomingEvents } from '../lib/events';
import { useTranslations, localizedPath, type Lang } from '../lib/i18n';
import EventCard from './EventCard.astro';
import CategoryFilter from './CategoryFilter.astro';
import CalendarMonth from './CalendarMonth.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const now = new Date();
const upcoming = getUpcomingEvents(now);
const nextMonthDate = new Date(now.getFullYear(), now.getMonth() + 1, 1);
---

<div class="mx-auto max-w-5xl px-4 py-10">
  <h1 class="mb-2 font-serif text-3xl font-bold sm:text-4xl">{t('agenda.title')}</h1>
  <p class="mb-6 text-stone">
    <a href={localizedPath('/passats', lang)} class="underline hover:text-grape">{t('nav.past')}</a>
  </p>

  <div class="mb-6 inline-flex rounded-full border border-stone/30 bg-white p-1" role="tablist">
    <button
      type="button"
      class="rounded-full bg-grape px-4 py-2 text-sm font-semibold text-white"
      data-view-btn="list"
      aria-pressed="true"
    >
      {t('agenda.viewList')}
    </button>
    <button
      type="button"
      class="rounded-full px-4 py-2 text-sm font-semibold"
      data-view-btn="calendar"
      aria-pressed="false"
    >
      {t('agenda.viewCalendar')}
    </button>
  </div>

  <div data-view="list">
    <CategoryFilter lang={lang} />
    {
      upcoming.length === 0 ? (
        <p class="rounded-xl bg-white p-6 text-center text-stone shadow-sm">{t('agenda.noResults')}</p>
      ) : (
        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {upcoming.map((event) => (
            <EventCard event={event} lang={lang} />
          ))}
        </div>
      )
    }
  </div>

  <div data-view="calendar" class="hidden">
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
      <CalendarMonth year={now.getFullYear()} month={now.getMonth()} events={upcoming} lang={lang} />
      <CalendarMonth year={nextMonthDate.getFullYear()} month={nextMonthDate.getMonth()} events={upcoming} lang={lang} />
    </div>
  </div>
</div>

<script>
  const viewButtons = document.querySelectorAll<HTMLButtonElement>('[data-view-btn]');
  const views = {
    list: document.querySelector<HTMLElement>('[data-view="list"]'),
    calendar: document.querySelector<HTMLElement>('[data-view="calendar"]'),
  };

  viewButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.viewBtn as 'list' | 'calendar';
      Object.entries(views).forEach(([key, el]) => {
        el?.classList.toggle('hidden', key !== target);
      });
      viewButtons.forEach((b) => {
        const active = b === btn;
        b.setAttribute('aria-pressed', String(active));
        b.classList.toggle('bg-grape', active);
        b.classList.toggle('text-white', active);
      });
    });
  });
</script>
