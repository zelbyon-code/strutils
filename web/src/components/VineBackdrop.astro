---
// Subtle tileable vine-leaf pattern used as a decorative section backdrop.
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<svg class={className} aria-hidden="true" preserveAspectRatio="xMidYMid slice">
  <defs>
    <pattern id="vine-leaf" width="72" height="72" patternUnits="userSpaceOnUse" patternTransform="rotate(8)">
      <path
        d="M36 8c9 6 13 16 8 26-3 6-10 9-16 6-7-3-10-11-6-18 3-5 9-9 14-14z"
        fill="currentColor"
      />
      <path d="M36 8c-2 8-1 18 4 26" stroke="currentColor" stroke-width="1.4" fill="none" opacity="0.6" />
    </pattern>
  </defs>
  <rect width="100%" height="100%" fill="url(#vine-leaf)" />
</svg>
